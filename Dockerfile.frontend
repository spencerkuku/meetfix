FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY packages ./packages
RUN npm ci
COPY . .
RUN npm run build --workspace=repair-visibility
# Same-origin by default: the frontend and API are served from the same
# Caddy origin in this deployment, so requests need no absolute host. Only
# override this build arg for a setup where they're served separately.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine AS runtime
COPY --from=build /app/dist /srv
