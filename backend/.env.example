# 資料庫連線字串，本機開發用（格式：postgresql://帳號:密碼@主機:port/資料庫名稱?schema=public）。
DATABASE_URL="postgresql://meetfix:devpass@localhost:5432/meetfix?schema=public"
# API 監聽的埠號。
PORT=3001

# Google OAuth（Google Cloud Console -> APIs & Services -> Credentials）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必須與 Google Cloud Console 上註冊的 redirect URI 完全一致
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# 只有此 Google Workspace 網域可以登入（學校的網域）
SCHOOL_GOOGLE_DOMAIN=school.edu.tw

# 前端的位置——Google 登入驗證後會導回此處
FRONTEND_URL=http://localhost:3000

# 用來簽署 session JWT 的密鑰——以 `openssl rand -hex 32` 產生
JWT_SECRET=

# 平台管理員帳號，由 `npm run db:seed`（或 docker-entrypoint 啟動時）自動
# bootstrap。只在系統目前完全沒有 ADMIN 帳號時才會建立，之後一律略過，不
# 會覆蓋既有密碼。選填——兩者皆留空則略過。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=系統管理員
