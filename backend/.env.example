DATABASE_URL="postgresql://meetfix:devpass@localhost:5432/meetfix?schema=public"
PORT=3001

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Only this Google Workspace domain may log in (the school's domain)
SCHOOL_GOOGLE_DOMAIN=school.edu.tw

# Where to redirect back to after a successful Google login
FRONTEND_URL=http://localhost:3000

# Secret used to sign session JWTs — generate with `openssl rand -hex 32`
JWT_SECRET=

# 平台管理員帳號，由 `npm run db:seed`（或 docker-entrypoint 啟動時）自動
# bootstrap。只在系統目前完全沒有 ADMIN 帳號時才會建立，之後一律略過，不
# 會覆蓋既有密碼。選填——兩者皆留空則略過。
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=系統管理員
