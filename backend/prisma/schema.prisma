generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: one of three fixed permission levels a User holds. See CONTEXT.md.
enum Role {
  USER
  FACILITY_MANAGER
  ADMIN
}

// Account: the credential record backing a User's ability to log in.
// One Account per User. See CONTEXT.md.
enum AccountProvider {
  GOOGLE
  PASSWORD
}

// Account Status: only meaningful for PASSWORD accounts — GOOGLE accounts
// are always immediately usable. SUSPENDED is an Admin-driven, reversible
// block on login (distinct from PENDING, which is awaiting Account
// Approval) — it never applies to a PENDING Account. REJECTED is an Admin's
// Account Rejection of a PENDING Account — the User/Account row is kept
// (not deleted) so a resubmission with the same email can reuse it; see
// AuthService.registerWithPassword. See CONTEXT.md.
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(USER)
  // Real Google profile photo URL, captured/refreshed on every Google login
  // or account link. Null for password-only Users (and Google profiles with
  // no photo) — the frontend shows a fixed generic icon in that case, never
  // a synthesized placeholder. See issue #18.
  avatarUrl String?
  createdAt DateTime @default(now())
  // Reporter info (see RepairTicket.userClass/userPhone) saved from this
  // User's most recent Repair Ticket submission, so it can pre-fill the
  // next one. Also directly editable from Account Settings. Null until the
  // User's first Repair Ticket submission or profile edit — no backfill
  // from pre-existing RepairTicket rows.
  userClass String?
  userPhone String?

  account          Account?
  bookings         Booking[]
  reviewedBookings Booking[]       @relation("BookingReviewer")
  repairTickets    RepairTicket[]
  auditLogEntries  AuditLogEntry[]
}

// Auto-Approved Domain: an email domain an Admin has pre-cleared. A PASSWORD
// registration whose email matches activates immediately as Role USER;
// anything else lands PENDING for Account Approval. See CONTEXT.md, ADR-0003.
// `allowSubdomains` is per-entry and opt-in: when true, an email under any
// subdomain of `domain` also qualifies (e.g. `dept.xxx.edu.tw` for a
// `xxx.edu.tw` entry). Defaults false so existing entries (and any Admin
// adds for an unrelated domain, e.g. a vendor's) keep exact-match-only
// behavior unless explicitly widened.
model AutoApprovedDomain {
  id              String   @id @default(cuid())
  domain          String   @unique
  allowSubdomains Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model Account {
  id       String          @id @default(cuid())
  userId   String          @unique
  user     User            @relation(fields: [userId], references: [id])
  provider AccountProvider
  status   AccountStatus   @default(ACTIVE)

  // GOOGLE provider fields
  googleSub String? @unique

  // PASSWORD provider fields
  passwordHash String?

  createdAt DateTime @default(now())

  // Account Rejection: set only by AdminService.rejectAccount, describing
  // the most recent rejection only — older rejections remain in
  // AuditLogEntry but are not summarized here. Both null until the first
  // rejection; left untouched by a later resubmission (registerWithPassword)
  // so an Admin reviewing the resubmission still sees this context.
  lastRejectionReason String?
  lastRejectedAt      DateTime?
}

// Room: a physical bookable space. See CONTEXT.md. Only `name` and
// `location` are required at creation — `capacity`, `equipment`, and
// `imageUrl` may be filled in later via update.
model Room {
  id               String   @id @default(cuid())
  name             String
  location         String
  capacity         Int?
  equipment        String[]
  imageUrl         String?
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())

  bookings Booking[]
}

// Booking Status: see CONTEXT.md. CONFIRMED and PENDING_APPROVAL both hold
// the time slot exclusively; only REJECTED and CANCELLED release it.
enum BookingStatus {
  CONFIRMED
  PENDING_APPROVAL
  REJECTED
  CANCELLED
}

// Booking: a claim on a Room for a specific time range. See CONTEXT.md.
model Booking {
  id          String        @id @default(cuid())
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus
  createdAt   DateTime      @default(now())
  // Soft delete: set by the owner or an ADMIN removing a future Booking
  // from view, regardless of its `status`. Distinct from `status` — a
  // deleted Booking keeps whatever status it had (e.g. CANCELLED) and is
  // simply excluded from all reads. See issue #19.
  deletedAt   DateTime?

  // Booking Approval review trail: set together by BookingsService.decide()
  // (approve/reject) and cleared together by revert(). Both null for a
  // Booking that has never been through a decision — including one that's
  // CONFIRMED because its Room never required approval — which is how
  // revert() tells "reviewed CONFIRMED" apart from "auto-confirmed
  // CONFIRMED" (Room.requiresApproval alone can't, since it may have
  // changed since the Booking was decided).
  reviewedAt   DateTime?
  reviewedById String?
  reviewer     User?     @relation("BookingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([roomId, startTime, endTime])
}

// Repair Status: see CONTEXT.md. Set by whichever FACILITY_MANAGER user
// picks up the ticket — there is no per-ticket assignee field.
enum RepairStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Repair Category: an Admin-managed classification for Repair Tickets.
// Freely added/removed by Admins, not fixed at the code level. See
// CONTEXT.md. Tickets store the category name at submission time (below)
// rather than a hard foreign key, so removing a category never orphans or
// cascades into existing tickets' history.
model RepairCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Repair Ticket: a report of a facility problem at a free-text location,
// filed by a User. See CONTEXT.md.
model RepairTicket {
  id          String       @id @default(cuid())
  location    String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  userClass   String?
  userPhone   String?
  category    String
  description String
  imageUrl    String?
  status      RepairStatus @default(PENDING)
  adminReply  String?
  createdAt   DateTime     @default(now())
  // Soft delete: set by the reporter or an ADMIN removing a still-PENDING
  // Repair Ticket from view. Mirrors Booking.deletedAt (issue #19) — see
  // issue #25.
  deletedAt   DateTime?
}

// Audit Log Entry: an immutable record of who performed a state-changing
// action, when, and on what — currently scoped to Role changes, Booking
// Approvals, Account Approvals, Repair Status changes, Account
// Suspension/Reactivation, User Deletion, and (as a deliberate exception —
// see CONTEXT.md) the read-only but sensitive act of bulk-exporting Repair
// Ticket data. See CONTEXT.md.
// `targetType`/`targetId` deliberately isn't a typed FK — the target can be
// a User, Booking, Account or RepairTicket, and the log must outlive its
// target (never cascade-deleted). A Repair Export entry has no single
// target row, so targetType is the fixed string "RepairExport" and
// targetId is a fixed placeholder ("all") rather than a real id — the
// export's actual scope (date range, count) lives in `detail`.
enum AuditAction {
  ROLE_CHANGE
  BOOKING_APPROVAL
  ACCOUNT_APPROVAL
  REPAIR_STATUS_CHANGE
  AUTO_APPROVED_DOMAIN_CHANGE
  ACCOUNT_SUSPENSION
  ACCOUNT_REACTIVATION
  USER_DELETION
  REPAIR_EXPORT
  ACCOUNT_REJECTION
  BOOKING_REVERT
}

model AuditLogEntry {
  id         String      @id @default(cuid())
  // Nullable + SetNull: an actor whose User row is later deleted (User
  // Deletion) must not block that deletion, and must not silently vanish
  // from history — see `actorName` below.
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshot of the actor's name, populated only at the moment their User
  // row is deleted (see AdminService.deleteUser) so the entry still reads
  // "acted by <name>" after `actor` goes null instead of losing the
  // attribution entirely.
  actorName  String?
  action     AuditAction
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}
