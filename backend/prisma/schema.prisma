generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: one of four fixed permission levels a User holds. Never combined.
// See CONTEXT.md.
enum Role {
  USER
  MAINTENANCE
  ROOM_MANAGER
  ADMIN
}

// Account: the credential record backing a User's ability to log in.
// One Account per User. See CONTEXT.md.
enum AccountProvider {
  GOOGLE
  PASSWORD
}

// Account Status: only meaningful for PASSWORD accounts — GOOGLE accounts
// are always immediately usable. See CONTEXT.md.
enum AccountStatus {
  PENDING
  ACTIVE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  account        Account?
  bookings       Booking[]
  repairTickets  RepairTicket[]
  auditLogEntries AuditLogEntry[]
}

// Auto-Approved Domain: an email domain an Admin has pre-cleared. A PASSWORD
// registration whose email matches activates immediately as Role USER;
// anything else lands PENDING for Account Approval. See CONTEXT.md, ADR-0003.
model AutoApprovedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
}

model Account {
  id       String          @id @default(cuid())
  userId   String          @unique
  user     User            @relation(fields: [userId], references: [id])
  provider AccountProvider
  status   AccountStatus   @default(ACTIVE)

  // GOOGLE provider fields
  googleSub          String? @unique
  googleRefreshToken String?

  // PASSWORD provider fields
  passwordHash String?

  createdAt DateTime @default(now())
}

// Room: a physical bookable space. See CONTEXT.md.
model Room {
  id               String   @id @default(cuid())
  name             String
  capacity         Int
  equipment        String[]
  imageUrl         String
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())

  bookings      Booking[]
  repairTickets RepairTicket[]
}

// Booking Status: see CONTEXT.md. CONFIRMED and PENDING_APPROVAL both hold
// the time slot exclusively; only REJECTED and CANCELLED release it.
enum BookingStatus {
  CONFIRMED
  PENDING_APPROVAL
  REJECTED
  CANCELLED
}

// Booking: a claim on a Room for a specific time range. See CONTEXT.md.
model Booking {
  id          String        @id @default(cuid())
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus
  createdAt   DateTime      @default(now())
  // The synced Google Calendar event id for this Booking, set once it
  // becomes CONFIRMED for a Google-authenticated User. Null for
  // PENDING_APPROVAL Bookings, password-Account Users, or if the sync
  // itself failed. See CONTEXT.md, issue #11.
  googleEventId String?

  @@index([roomId, startTime, endTime])
}

// Repair Status: see CONTEXT.md. Set by whichever MAINTENANCE user picks
// up the ticket — there is no per-ticket assignee field.
enum RepairStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Repair Category: an Admin-managed classification for Repair Tickets.
// Freely added/removed by Admins, not fixed at the code level. See
// CONTEXT.md. Tickets store the category name at submission time (below)
// rather than a hard foreign key, so removing a category never orphans or
// cascades into existing tickets' history.
model RepairCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Repair Ticket: a report of a facility problem tied to a Room (roomId set)
// or a free-text location (roomId null, for shared spaces without a Room
// record). `location` is always a human-readable label — for a real Room
// it's a copy of the Room's name at submission time, so the ticket still
// reads sensibly even if the Room is later renamed or removed. See
// CONTEXT.md.
model RepairTicket {
  id          String       @id @default(cuid())
  roomId      String?
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  location    String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  userClass   String?
  userPhone   String?
  category    String
  description String
  imageUrl    String?
  status      RepairStatus @default(PENDING)
  adminReply  String?
  createdAt   DateTime     @default(now())
}

// Audit Log Entry: an immutable record of who performed a state-changing
// action, when, and on what — currently scoped to Role changes, Booking
// Approvals, Account Approvals, and Repair Status changes. See CONTEXT.md.
// `targetType`/`targetId` deliberately isn't a typed FK — the target can be
// a User, Booking, Account or RepairTicket, and the log must outlive its
// target (never cascade-deleted).
enum AuditAction {
  ROLE_CHANGE
  BOOKING_APPROVAL
  ACCOUNT_APPROVAL
  REPAIR_STATUS_CHANGE
}

model AuditLogEntry {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation(fields: [actorId], references: [id])
  action     AuditAction
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
}
