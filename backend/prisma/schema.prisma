generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role: one of four fixed permission levels a User holds. Never combined.
// See CONTEXT.md.
enum Role {
  USER
  MAINTENANCE
  ROOM_MANAGER
  ADMIN
}

// Account: the credential record backing a User's ability to log in.
// One Account per User. See CONTEXT.md.
enum AccountProvider {
  GOOGLE
  PASSWORD
}

// Account Status: only meaningful for PASSWORD accounts — GOOGLE accounts
// are always immediately usable. See CONTEXT.md.
enum AccountStatus {
  PENDING
  ACTIVE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  account  Account?
  bookings Booking[]
}

model Account {
  id       String          @id @default(cuid())
  userId   String          @unique
  user     User            @relation(fields: [userId], references: [id])
  provider AccountProvider
  status   AccountStatus   @default(ACTIVE)

  // GOOGLE provider fields
  googleSub          String? @unique
  googleRefreshToken String?

  // PASSWORD provider fields (populated by a later ticket)
  passwordHash String?

  createdAt DateTime @default(now())
}

// Room: a physical bookable space. See CONTEXT.md.
model Room {
  id               String   @id @default(cuid())
  name             String
  capacity         Int
  equipment        String[]
  imageUrl         String
  requiresApproval Boolean  @default(false)
  createdAt        DateTime @default(now())

  bookings Booking[]
}

// Booking Status: see CONTEXT.md. CONFIRMED and PENDING_APPROVAL both hold
// the time slot exclusively; only REJECTED and CANCELLED release it.
enum BookingStatus {
  CONFIRMED
  PENDING_APPROVAL
  REJECTED
  CANCELLED
}

// Booking: a claim on a Room for a specific time range. See CONTEXT.md.
model Booking {
  id          String        @id @default(cuid())
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus
  createdAt   DateTime      @default(now())

  @@index([roomId, startTime, endTime])
}
