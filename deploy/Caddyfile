{$SITE_ADDRESS} {
	# handle blocks are mutually exclusive and evaluated in order, unlike
	# bare directives (which run in Caddy's fixed internal precedence, not
	# textual order) — that matters here because try_files would otherwise
	# rewrite /api/* requests to /index.html before reverse_proxy ever saw
	# them.
	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		file_server
		try_files {path} /index.html
	}
}
