POSTGRES_USER=meetfix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meetfix

# backup 服務保留的資料庫備份天數。選填。
BACKUP_RETENTION_DAYS=14

# Caddy 服務並自動核發 HTTPS 憑證的網域（例如 meetfix.your-school.edu.tw）。
# 本機開發請保留 "localhost"（純 HTTP，無憑證）。
SITE_ADDRESS=localhost

# 供前端（Vite）開發伺服器讀取——用來指定後端 API 的位置。
VITE_API_URL=http://localhost:3001

# Google OAuth（Google Cloud Console -> APIs & Services -> Credentials）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 必須與 Google Cloud Console 上註冊的 redirect URI 完全一致，例如 https://meetfix.your-school.edu.tw/auth/google/callback
GOOGLE_CALLBACK_URL=

# 只有此 Google Workspace 網域可以登入（學校的網域）
SCHOOL_GOOGLE_DOMAIN=school.edu.tw

# 前端的公開網址——Google 登入後會導回此處
FRONTEND_URL=http://localhost:3000

# 用來簽署 session JWT 的密鑰——以 `openssl rand -hex 32` 產生
JWT_SECRET=

# 32 位元組金鑰（64 個 hex 字元），用於加密儲存中的 Google refresh token
# ——以 `openssl rand -hex 32` 產生
ENCRYPTION_KEY=

# 交易型 Email 通知用的 SMTP 設定。全部選填——SMTP_HOST 留空即可完全停用
# 寄信功能（通知會被靜默略過，並以 debug 等級記錄）。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=meetfix@your-school.edu.tw
