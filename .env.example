POSTGRES_USER=meetfix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meetfix

# The domain Caddy will serve and auto-provision HTTPS for (e.g. meetfix.your-school.edu.tw).
# Leave as "localhost" for local development (plain HTTP, no certificate).
SITE_ADDRESS=localhost

# Read by the front-end (Vite) dev server — where the backend API lives.
VITE_API_URL=http://localhost:3001

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the public URL Caddy serves this API on, e.g. https://meetfix.your-school.edu.tw/auth/google/callback
GOOGLE_CALLBACK_URL=

# Only this Google Workspace domain may log in (the school's domain)
SCHOOL_GOOGLE_DOMAIN=school.edu.tw

# The public URL of the front end — Google login redirects back here
FRONTEND_URL=http://localhost:3000

# Secret used to sign session JWTs — generate with `openssl rand -hex 32`
JWT_SECRET=

# 32-byte key (64 hex chars) used to encrypt stored Google refresh tokens at
# rest — generate with `openssl rand -hex 32`
ENCRYPTION_KEY=
