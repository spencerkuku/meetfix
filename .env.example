# 資料庫帳號，postgres 與 api 服務共用。
POSTGRES_USER=meetfix
# 資料庫密碼，postgres 與 api 服務共用。請自行更換，不要沿用預設值。
POSTGRES_PASSWORD=change-me
# 資料庫名稱，postgres 與 api 服務共用。
POSTGRES_DB=meetfix

# backup 服務保留的資料庫備份天數。選填，預設為 14。
BACKUP_RETENTION_DAYS=14

# Caddy 服務並自動核發 HTTPS 憑證的網域（例如 meetfix.your-school.edu.tw）。
# 本機開發請保留 "localhost"（純 HTTP，無憑證）。
SITE_ADDRESS=localhost

# 供前端（Vite）開發伺服器讀取——用來指定後端 API 的位置。
VITE_API_URL=http://localhost:3001

# 顯示於畫面 footer 的校名。選填——留空則 footer 不顯示校名，只顯示系統名稱。
VITE_SCHOOL_NAME=嘉義高工

# Google OAuth Client ID，取自 Google Cloud Console -> APIs & Services -> Credentials。
GOOGLE_CLIENT_ID=
# Google OAuth Client Secret，與上方 Client ID 同一組憑證。
GOOGLE_CLIENT_SECRET=
# 必須與 Google Cloud Console 上註冊的 redirect URI 完全一致，例如 https://meetfix.your-school.edu.tw/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# 只有此 Google Workspace 網域可以登入（學校的網域），其餘一律拒絕。
SCHOOL_GOOGLE_DOMAIN=school.edu.tw

# 前端的公開網址——Google 登入後會導回此處。
FRONTEND_URL=http://localhost:3000

# 用來簽署 session JWT 的密鑰——以 `openssl rand -hex 32` 產生。
JWT_SECRET=

# 平台管理員帳號的 email，容器啟動時自動 bootstrap（只在系統目前完全沒有
# ADMIN 帳號時才會建立，之後一律略過，不會覆蓋既有密碼）。選填——留空則跳過。
SEED_ADMIN_EMAIL=
# 平台管理員帳號的初始密碼，僅在上方 email 有填且尚無 ADMIN 帳號時使用。
SEED_ADMIN_PASSWORD=
# 平台管理員帳號的顯示名稱，僅在上方 email 有填且尚無 ADMIN 帳號時使用。
SEED_ADMIN_NAME=系統管理員
